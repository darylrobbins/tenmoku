# fe-chat's messages: why a chat file, a code block or a reply failed.

chat-id-invalid = a chat id is 26 Crockford base32 chars
chat-edit-markers-malformed = its SEARCH/REPLACE markers don't match up at line { $line }
chat-edit-path-outside = { $path } is outside the folder
chat-store-diverged = { $path } was changed elsewhere (revision { $current })
chat-store-unreadable = { $path } isn't a chat this version reads: { $reason }
chat-store-version = version { $version }
chat-reply-ended-early = the reply ended early
