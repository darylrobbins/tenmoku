{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "csv",
      "camelcase": "Csv",
      "title": "CSV",
      "scope": "text.csv",
      "path": "csv",
      "file-types": ["csv"]
    },
    {
      "name": "tsv",
      "camelcase": "Tsv",
      "title": "TSV",
      "scope": "text.tsv",
      "path": "tsv",
      "file-types": ["tsv", "tab"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "CSV and TSV grammars whose columns a query can count"
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
