# fe-nav's messages.

nav-unavailable = unavailable: { $why }
nav-cancelled = cancelled
nav-unsupported = unsupported
nav-scip-io = reading the SCIP index: { $kind }
nav-scip-decode = decoding the SCIP index: { $why }
nav-scip-bad-tag = bad field tag { $tag }
nav-scip-not-indexed = not in the SCIP index
nav-scip-no-definition = no definition in the SCIP index matches its file
