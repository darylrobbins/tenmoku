package fastedit:editor@1.1.0;

/// A plugin for fastedit: a kiln extension with the editor's own imports.
///
/// API 1.1, a preview, as is the `kiln:extension` world it includes: incompatible changes may come
/// in any release until they are declared stable. Released minors are frozen in `released/`; a
/// 1.1 change to them is additive only (new interfaces and functions, never a new case or field
/// in an existing type), and the host serves each released minor's world.
world editor-extension {
    include kiln:extension/extension@1.1.0;

    import buffer;
    import decorations;
    import diagnostics;
    import formatting;
    import status;
}
