{
  "nvim": "0.12.4",
  "cases": [
    {
      "name": "ic_then_search",
      "buffer": "x\nHello world\nhello",
      "cursor": [
        0,
        0
      ],
      "keys": ":set ic<CR>/hello<CR>",
      "expect": {
        "buffer": "x\nHello world\nhello",
        "cursor": [
          1,
          0
        ],
        "mode": "n",
        "registers": {
          "/": {
            "text": "hello",
            "linewise": false
          }
        }
      }
    },
    {
      "name": "ic_scs_lower",
