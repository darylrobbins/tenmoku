      "keys": "<C-v>jlyG]p",
      "expect": {
        "buffer": "ab\ncd\n ab   x\n cd",
        "cursor": [
          2,
          1
        ],
        "mode": "n",
        "registers": {
          "\"": {
            "text": "ab\ncd",
            "linewise": false,
            "block_width": 2
          },
          "0": {
            "text": "ab\ncd",
            "linewise": false,
            "block_width": 2
          }
        },
        "marks": {
          "<": [
            0,
            0
          ],
          ">": [
            1,
            1
          ]
        }
      }
