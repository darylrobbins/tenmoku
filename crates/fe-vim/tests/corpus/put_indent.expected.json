{
  "nvim": "0.12.4",
  "cases": [
    {
      "name": "bracket_p_below_indents",
      "buffer": "    foo\nbar",
      "cursor": [
        1,
        0
      ],
      "keys": "yyk]p",
      "expect": {
        "buffer": "    foo\n    bar\nbar",
        "cursor": [
          1,
          4
        ],
        "mode": "n",
        "registers": {
          "\"": {
            "text": "bar\n",
            "linewise": true
          },
          "0": {
            "text": "bar\n",
            "linewise": true
          }
        }
      }
    },
    {
      "name": "bracket_p_above_indents",
