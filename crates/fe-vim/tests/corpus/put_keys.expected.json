{
  "nvim": "0.12.4",
  "cases": [
    {
      "name": "y_to_line_end",
      "buffer": "abc def\nxyz",
      "cursor": [
        0,
        4
      ],
      "keys": "Yp",
      "expect": {
        "buffer": "abc ddefef\nxyz",
        "cursor": [
          0,
          7
        ],
        "mode": "n",
        "registers": {
          "\"": {
            "text": "def",
            "linewise": false
          },
          "0": {
            "text": "def",
            "linewise": false
          }
        }
      }
    },
    {
      "name": "y_with_count",
      "buffer": "abc def\nxyz",
      "cursor": [
        0,
        4
      ],
      "keys": "2Yp",
      "expect": {
        "buffer": "abc ddef\nxyzef\nxyz",
        "cursor": [
          0,
          5
        ],
        "mode": "n",
        "registers": {
          "\"": {
            "text": "def\nxyz",
            "linewise": false
          },
          "0": {
            "text": "def\nxyz",
            "linewise": false
          }
        }
      }
    },
