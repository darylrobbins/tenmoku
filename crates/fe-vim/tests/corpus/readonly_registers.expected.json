    {
      "name": "dot_unset_fails",
      "buffer": "abc",
      "cursor": [
        0,
        0
      ],
      "keys": "\".p",
      "expect": {
        "buffer": "abc",
        "cursor": [
          0,
          0
        ],
        "mode": "n",
        "registers": {}
      }
    },
