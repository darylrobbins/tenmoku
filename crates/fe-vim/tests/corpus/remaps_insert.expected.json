    {
      "name": "remap_replace_mode",
      "buffer": "abcdef",
      "cursor": [
        0,
        0
      ],
      "keys": "Rqjkx",
      "mapping": [
        "inoremap jk <Esc>",
        "inoremap q Q"
      ],
      "expect": {
        "buffer": "bcdef",
        "cursor": [
          0,
          0
        ],
        "mode": "n",
        "registers": {
          "\"": {
            "text": "Q",
            "linewise": false
          },
          "-": {
            "text": "Q",
            "linewise": false
          }
        }
      }
    },
    {
      "name": "remap_nmap_then_imap",
      "buffer": "xyz",
      "cursor": [
        0,
        0
      ],
      "keys": "ab<Esc>",
      "mapping": [
        "nmap ab abx",
        "imap b B"
      ],
      "expect": {
        "buffer": "xBxyz",
        "cursor": [
          0,
          2
        ],
        "mode": "n",
        "registers": {}
      }
    },
