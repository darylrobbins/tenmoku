{
  "nvim": "0.12.4",
  "cases": [
    {
      "name": "remap_insert_esc",
      "buffer": "abc",
      "cursor": [
        0,
        0
      ],
      "keys": "ijkx",
      "mapping": [
        "inoremap jk <Esc>"
      ],
      "expect": {
        "buffer": "bc",
        "cursor": [
          0,
          0
        ],
        "mode": "n",
        "registers": {
          "\"": {
            "text": "a",
            "linewise": false
          },
          "-": {
            "text": "a",
            "linewise": false
          }
        }
      }
    },
    {
      "name": "remap_insert_expansion",
      "buffer": "abc",
      "cursor": [
        0,
        0
      ],
      "keys": "ikj<Esc>",
      "mapping": [
        "inoremap kj hello"
      ],
      "expect": {
        "buffer": "helloabc",
        "cursor": [
          0,
          4
        ],
        "mode": "n",
        "registers": {}
      }
    },
    {
      "name": "remap_insert_imap_chain",
      "buffer": "x",
      "cursor": [
        0,
        0
      ],
      "keys": "ia<Esc>",
      "mapping": [
        "imap a b",
        "imap b c"
      ],
      "expect": {
        "buffer": "cx",
        "cursor": [
          0,
          0
        ],
        "mode": "n",
        "registers": {}
      }
    },
