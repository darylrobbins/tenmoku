          0
        ],
        "mode": "n",
        "registers": {
          "\"": {
            "text": "abc ",
            "linewise": false
          },
          "-": {
            "text": "abc ",
            "linewise": false
          },
          "/": {
            "text": "WORLD",
            "linewise": false
          },
          "1": {
            "text": "abc ",
            "linewise": false
          }
        }
