    {
      "name": "ic_operator_search",
      "buffer": "abc world WORLD",
      "cursor": [
        0,
        0
      ],
      "keys": "d/WORLD<CR>",
      "set": "ignorecase",
      "expect": {
        "buffer": "world WORLD",
        "cursor": [
