{
  "nvim": "0.12.4",
  "cases": [
    {
      "name": "default_exact",
      "buffer": "x\nHello world\nhello",
      "cursor": [
        0,
        0
      ],
      "keys": "/hello<CR>",
      "expect": {
        "buffer": "x\nHello world\nhello",
        "cursor": [
          2,
          0
        ],
        "mode": "n",
        "registers": {
          "/": {
            "text": "hello",
            "linewise": false
          }
        }
      }
    },
    {
