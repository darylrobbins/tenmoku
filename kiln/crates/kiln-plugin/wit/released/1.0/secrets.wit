package kiln:extension@1.0.0;

/// The plugin's secrets, kept by the host in the system keychain as `ext.<plugin id>.<name>`.
/// Another plugin's secrets are out of reach, and no grant is needed.
///
/// A name is 1 to 64 characters of `a-z`, `0-9`, `_` and `-`; any other is `invalid-argument`.
/// A value is at most 1280 bytes, on every OS: Windows Credential Manager keeps a credential's
/// blob in 2560 bytes, as UTF-16, and a longer value is `invalid-argument`.
///
/// An unavailable or declined keychain is `failed` or `denied`.
interface secrets {
    use types.{error};

    /// None when no secret has that name.
    get: func(name: string) -> result<option<string>, error>;
    set: func(name: string, value: string) -> result<_, error>;
    /// Deleting a name that has no secret succeeds.
    delete: func(name: string) -> result<_, error>;
}
