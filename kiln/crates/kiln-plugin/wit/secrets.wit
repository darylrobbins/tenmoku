package kiln:extension@1.0.0;

/// The plugin's secrets, kept by the host in the system keychain under the plugin's name.
interface secrets {
    use types.{error};

    /// None when no secret has that name.
    get: func(name: string) -> result<option<string>, error>;
    set: func(name: string, value: string) -> result<_, error>;
    /// Deleting a name that has no secret succeeds.
    delete: func(name: string) -> result<_, error>;
}
